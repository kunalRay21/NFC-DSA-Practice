{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Current Java File",
            "type": "shell",
            "command": "java",
            "args": [
                "${file}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true
            }
        },
        {
            "label": "Compile All 45 Java Files",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "New-Item -ItemType Directory -Path bin -Force | Out-Null; javac -d bin (Get-ChildItem -Recurse -Filter *.java | Select-Object -ExpandProperty FullName); Write-Host 'All files compiled into bin/ successfully!'"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
